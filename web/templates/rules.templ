package templates

import (
	"fmt"
	"github.com/tomassar/credit-score-evaluator/internal/models"
)

type RulesData struct {
	Rules         []*models.Rule
	FlashMessages []map[string]string
}

templ RulesPage(data RulesData) {
	@Base("Rules", RulesContent(data))
}

templ RulesContent(data RulesData) {
	<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
		<!-- Flash Messages -->
		<div id="flash-messages">
			@FlashMessages(data.FlashMessages)
		</div>

		<!-- Page Header -->
		<div class="md:flex md:items-center md:justify-between mb-8">
			<div class="flex-1 min-w-0">
				<h1 class="text-3xl font-bold text-gray-900 dark:text-white">Scoring Rules</h1>
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
					Configure rules to automatically calculate risk scores
				</p>
			</div>
			<div class="mt-4 flex md:mt-0 md:ml-4">
				<button 
					hx-get="/htmx/rule-modal"
					hx-target="#modal-container"
					hx-swap="innerHTML"
					class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
					</svg>
					Add Rule
				</button>
			</div>
		</div>

		<!-- Rules List -->
		<div id="rules-list" 
			 hx-get="/htmx/rules-list" 
			 hx-trigger="load, rule-saved from:body, rule-deleted from:body"
			 hx-swap="innerHTML">
			@RulesList(data.Rules)
		</div>

		<!-- Beautiful Add New Rule Section -->
		<div class="mt-12 mb-8">
			<div class="relative">
				<!-- Gradient Background -->
				<div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-blue-900/20 dark:via-indigo-900/20 dark:to-purple-900/20 rounded-3xl"></div>
				<div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 via-indigo-500/5 to-purple-500/5 dark:from-blue-400/10 dark:via-indigo-400/10 dark:to-purple-400/10 rounded-3xl"></div>
				
				<!-- Content -->
				<div class="relative bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-3xl shadow-2xl dark:border-gray-700/50 p-8 sm:p-12">
					<!-- Header -->
					<div class="text-center mb-8">
						<div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl shadow-lg mb-4">
							<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
							</svg>
						</div>
						<h2 class="text-3xl font-bold bg-gradient-to-r from-gray-900 to-gray-700 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
							Add New Rule
						</h2>
						<p class="mt-2 text-gray-600 dark:text-gray-400 text-lg">
							Create intelligent scoring rules to assess borrower risk automatically
						</p>
					</div>

					<!-- Form -->
					<form 
						hx-post="/htmx/rules"
						hx-target="#rules-list"
						hx-swap="innerHTML"
						hx-on::after-request="if(event.detail.xhr.status === 200) this.reset()"
						class="space-y-8"
					>
						<!-- Rule Name and Description -->
						<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
							<div class="space-y-2">
								<label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">
									<span class="flex items-center">
										<svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
										</svg>
										Rule Name
									</span>
								</label>
								<input 
									name="name" 
									type="text" 
									required 
									placeholder="e.g., High Income Bonus"
									class="w-full px-4 py-3 bg-white/60 dark:bg-gray-700/60 backdrop-blur-sm border border-gray-200 dark:border-gray-600 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
								/>
							</div>
							<div class="space-y-2">
								<label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">
									<span class="flex items-center">
										<svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
										</svg>
										Description
									</span>
								</label>
								<textarea 
									name="description" 
									rows="3" 
									placeholder="Describe what this rule evaluates..."
									class="w-full px-4 py-3 bg-white/60 dark:bg-gray-700/60 backdrop-blur-sm border border-gray-200 dark:border-gray-600 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 resize-none"
								></textarea>
							</div>
						</div>

						<!-- Rule Configuration -->
						<div class="bg-gradient-to-r from-gray-50/50 to-gray-100/50 dark:from-gray-700/30 dark:to-gray-800/30 rounded-2xl p-6 space-y-6">
							<h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center">
								<svg class="w-5 h-5 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								</svg>
								Rule Configuration
							</h3>
							
							<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
								<div class="space-y-2">
									<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Field</label>
									<select 
										name="field" 
										required 
										class="w-full px-4 py-3 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-gray-200 dark:border-gray-600 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-gray-900 dark:text-white"
									>
										<option value="">Select field...</option>
										<option value="age">Age</option>
										<option value="monthly_income">Monthly Income</option>
										<option value="employment_status">Employment Status</option>
										<option value="dependents">Dependents</option>
										<option value="existing_loans">Existing Loans</option>
										<option value="savings_balance">Savings Balance</option>
									</select>
								</div>
								<div class="space-y-2">
									<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Operator</label>
									<select 
										name="operator" 
										required 
										class="w-full px-4 py-3 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-gray-200 dark:border-gray-600 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-gray-900 dark:text-white"
									>
										<option value="">Select operator...</option>
										<option value="lt">Less than (&lt;)</option>
										<option value="lte">Less than or equal (≤)</option>
										<option value="gt">Greater than (&gt;)</option>
										<option value="gte">Greater than or equal (≥)</option>
										<option value="eq">Equal to (=)</option>
										<option value="neq">Not equal to (≠)</option>
										<option value="contains">Contains</option>
										<option value="not_contains">Does not contain</option>
									</select>
								</div>
								<div class="space-y-2">
									<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Value</label>
									<input 
										name="value" 
										type="text" 
										required 
										placeholder="e.g., 50000"
										class="w-full px-4 py-3 bg-white/80 dark:bg-gray-700/80 backdrop-blur-sm border border-gray-200 dark:border-gray-600 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
									/>
								</div>
							</div>
						</div>

						<!-- Weight and Status -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
							<div class="space-y-2">
								<label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">
									<span class="flex items-center">
										<svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
										</svg>
										Weight (-100 to +100)
									</span>
								</label>
								<input 
									name="weight" 
									type="number" 
									min="-100" 
									max="100" 
									required 
									placeholder="e.g., +25 or -15"
									class="w-full px-4 py-3 bg-white/60 dark:bg-gray-700/60 backdrop-blur-sm border border-gray-200 dark:border-gray-600 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400"
								/>
								<p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Positive values increase risk score, negative values decrease it</p>
							</div>
							<div class="space-y-2">
								<label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">
									<span class="flex items-center">
										<svg class="w-4 h-4 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
										Rule Status
									</span>
								</label>
								<div class="flex items-center space-x-3 pt-3">
									<input 
										name="is_active" 
										type="checkbox" 
										checked 
										class="h-5 w-5 text-blue-600 focus:ring-blue-500 border-gray-300 dark:border-gray-600 rounded-md transition-all duration-200"
									/>
									<span class="text-gray-700 dark:text-gray-300 font-medium">Active (rule will be applied to scoring)</span>
								</div>
							</div>
						</div>

						<!-- Submit Button -->
						<div class="pt-6 border-t border-gray-200/50 dark:border-gray-700/50">
							<div class="flex justify-center">
								<button 
									type="submit" 
									class="group relative inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold rounded-2xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
								>
									<svg class="w-5 h-5 mr-3 group-hover:scale-110 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
									</svg>
									<span class="text-lg">Create Scoring Rule</span>
									<div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl blur opacity-30 group-hover:opacity-50 transition-opacity duration-200 -z-10"></div>
								</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>

		<!-- Modal Container -->
		<div id="modal-container" 
			 hx-on:close-modal="this.innerHTML = ''"
			 hx-on:htmx:afterRequest="if(event.detail.xhr.status === 200 && event.detail.xhr.response.includes('rule-modal')) { /* Modal loaded */ }">
		</div>
	</div>
}

templ RulesList(rules []*models.Rule) {
	if len(rules) == 0 {
		<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
			<div class="text-center py-12">
				<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"/>
				</svg>
				<h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-white">No rules configured</h3>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
					Get started by creating your first scoring rule.
				</p>
				<div class="mt-6">
					<button 
						hx-get="/htmx/rule-modal"
						hx-target="#modal-container"
						hx-swap="innerHTML"
						class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700"
					>
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
						</svg>
						Add First Rule
					</button>
				</div>
			</div>
		</div>
	} else {
		<div class="space-y-4">
			for _, rule := range rules {
				<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
					<div class="px-4 py-5 sm:p-6">
						<div class="flex items-center justify-between">
							<div class="flex-1">
								<div class="flex items-center space-x-3">
									<h3 class="text-lg font-medium text-gray-900 dark:text-white">
										{ rule.Name }
									</h3>
									<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", ruleStatusClass(rule.IsActive) }>
										if rule.IsActive {
											Active
										} else {
											Inactive
										}
									</span>
									<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", ruleWeightClass(rule.Weight) }>
										Weight: { fmt.Sprintf("%+d", rule.Weight) }
									</span>
								</div>
								<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
									{ rule.Description }
								</p>
								<div class="mt-2 text-sm text-gray-600 dark:text-gray-300">
									<span class="font-medium">Condition:</span>
									<code class="ml-1 px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-xs">
										{ rule.Field } { operatorDisplay(rule.Operator) } { rule.Value }
									</code>
								</div>
							</div>
							<div class="flex items-center space-x-2">
								<button 
									hx-get={ fmt.Sprintf("/htmx/rule-modal/%s", rule.ID.String()) }
									hx-target="#modal-container"
									hx-swap="innerHTML"
									class="inline-flex items-center p-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600"
								>
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
									</svg>
								</button>
								<button 
									hx-post={ fmt.Sprintf("/htmx/rules/%s/delete", rule.ID.String()) }
									hx-target="#rules-list"
									hx-confirm="Are you sure you want to delete this rule?"
									class="inline-flex items-center p-2 border border-red-300 dark:border-red-600 rounded-md shadow-sm text-sm font-medium text-red-700 dark:text-red-200 bg-white dark:bg-gray-700 hover:bg-red-50 dark:hover:bg-red-900"
								>
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
									</svg>
								</button>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
}

templ RuleModal(rule *models.Rule, isEditing bool) {
	<div id="rule-modal" class="fixed inset-0 z-50 overflow-y-auto">
		<div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
			<div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
			<span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
			<div class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
				<form 
					if isEditing {
						hx-post={ fmt.Sprintf("/htmx/rules/%s", rule.ID.String()) }
					} else {
						hx-post="/htmx/rules"
					}
					hx-target="#modal-container" 
					hx-swap="innerHTML">
					<div class="bg-white dark:bg-gray-800 px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
						<div class="sm:flex sm:items-start">
							<div class="mt-3 text-center sm:mt-0 sm:text-left w-full">
								<h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-white">
									if isEditing {
										Edit Rule
									} else {
										Add New Rule
									}
								</h3>
								<div class="mt-4 space-y-4">
									<div>
										<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Rule Name</label>
										<input name="name" type="text" value={ rule.Name } required class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm"/>
									</div>
									<div>
										<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Description</label>
										<textarea name="description" rows="2" class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm">{ rule.Description }</textarea>
									</div>
									<div class="grid grid-cols-2 gap-4">
										<div>
											<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Field</label>
											<select name="field" required class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm">
												<option value="">Select field...</option>
												<option value="age" selected?={ rule.Field == "age" }>Age</option>
												<option value="monthly_income" selected?={ rule.Field == "monthly_income" }>Monthly Income</option>
												<option value="employment_status" selected?={ rule.Field == "employment_status" }>Employment Status</option>
												<option value="dependents" selected?={ rule.Field == "dependents" }>Dependents</option>
												<option value="existing_loans" selected?={ rule.Field == "existing_loans" }>Existing Loans</option>
												<option value="savings_balance" selected?={ rule.Field == "savings_balance" }>Savings Balance</option>
											</select>
										</div>
										<div>
											<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Operator</label>
											<select name="operator" required class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm">
												<option value="">Select operator...</option>
												<option value="lt" selected?={ rule.Operator == "lt" }>Less than</option>
												<option value="lte" selected?={ rule.Operator == "lte" }>Less than or equal</option>
												<option value="gt" selected?={ rule.Operator == "gt" }>Greater than</option>
												<option value="gte" selected?={ rule.Operator == "gte" }>Greater than or equal</option>
												<option value="eq" selected?={ rule.Operator == "eq" }>Equal to</option>
												<option value="neq" selected?={ rule.Operator == "neq" }>Not equal to</option>
												<option value="contains" selected?={ rule.Operator == "contains" }>Contains</option>
												<option value="not_contains" selected?={ rule.Operator == "not_contains" }>Does not contain</option>
											</select>
										</div>
									</div>
									<div class="grid grid-cols-2 gap-4">
										<div>
											<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Value</label>
											<input name="value" type="text" value={ rule.Value } required class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm"/>
										</div>
										<div>
											<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Weight</label>
											<input name="weight" type="number" min="-100" max="100" value={ fmt.Sprintf("%d", rule.Weight) } required class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm"/>
										</div>
									</div>
									<div class="flex items-center">
										<input name="is_active" type="checkbox" checked?={ rule.IsActive } class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 dark:border-gray-600 rounded dark:bg-gray-700"/>
										<label class="ml-2 block text-sm text-gray-700 dark:text-gray-300">Active</label>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="bg-gray-50 dark:bg-gray-700 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
						<button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:ml-3 sm:w-auto sm:text-sm">
							if isEditing {
								Update
							} else {
								Create
							}
						</button>
						<button type="button" 
								onclick="document.getElementById('rule-modal').remove()"
								class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 dark:border-gray-600 shadow-sm px-4 py-2 bg-white dark:bg-gray-800 text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
							Cancel
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

func ruleStatusClass(isActive bool) string {
	if isActive {
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	}
	return "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
}

func ruleWeightClass(weight int) string {
	if weight > 0 {
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	} else if weight < 0 {
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	}
	return "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
}

func operatorDisplay(operator string) string {
	switch operator {
	case "lt":
		return "<"
	case "lte":
		return "≤"
	case "gt":
		return ">"
	case "gte":
		return "≥"
	case "eq":
		return "="
	case "neq":
		return "≠"
	case "contains":
		return "contains"
	case "not_contains":
		return "not contains"
	default:
		return operator
	}
}

// Flash messages component for HTMX
templ FlashMessages(messages []map[string]string) {
	for _, flash := range messages {
		<div class={ "rounded-md p-4 mb-4 flash-message", flashClass(flash["type"]) }>
			<div class="flex">
				<div class="flex-shrink-0">
					@flashIcon(flash["type"])
				</div>
				<div class="ml-3 flex-1">
					<p class={ "text-sm font-medium", flashTextClass(flash["type"]) }>
						{ flash["message"] }
					</p>
				</div>
				<div class="ml-4 flex-shrink-0">
					<button onclick="this.parentElement.parentElement.parentElement.remove()" class="inline-flex text-gray-400 hover:text-gray-600 focus:outline-none focus:text-gray-600 transition ease-in-out duration-150">
						<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
						</svg>
					</button>
				</div>
			</div>
		</div>
	}
}