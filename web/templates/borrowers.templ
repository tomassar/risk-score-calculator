package templates

import (
	"fmt"
	"github.com/tomassar/credit-score-evaluator/internal/models"
)

type BorrowersData struct {
	Borrowers     []*models.Borrower
	FlashMessages []map[string]string
}

templ BorrowersPage(data BorrowersData) {
	@Base("Borrowers", BorrowersContent(data))
}

templ BorrowersContent(data BorrowersData) {
	<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
		<!-- Flash Messages -->
		if len(data.FlashMessages) > 0 {
			for _, flash := range data.FlashMessages {
				<div class={ "rounded-md p-4 mb-4", flashClass(flash["type"]) }>
					<div class="flex">
						<div class="flex-shrink-0">
							@flashIcon(flash["type"])
						</div>
						<div class="ml-3">
							<p class={ "text-sm font-medium", flashTextClass(flash["type"]) }>
								{ flash["message"] }
							</p>
						</div>
					</div>
				</div>
			}
		}

		<!-- Page Header -->
		<div class="md:flex md:items-center md:justify-between mb-8">
			<div class="flex-1 min-w-0">
				<h1 class="text-3xl font-bold text-gray-900 dark:text-white">Borrowers</h1>
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
					Review and manage borrower risk scores
				</p>
			</div>
			<div class="mt-4 flex md:mt-0 md:ml-4">
				<a href="/api/borrowers/export" class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
					</svg>
					Export CSV
				</a>
			</div>
		</div>

		<!-- Filters -->
		<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 mb-6">
			<div class="px-4 py-5 sm:p-6">
				<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Filters</h3>
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
					<div>
						<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
							Min Score
						</label>
						<input 
							type="number" 
							id="min_score" 
							name="min_score"
							min="0" 
							max="150"
							class="block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm"
							hx-get="/htmx/borrowers-table"
							hx-trigger="input changed delay:500ms"
							hx-target="#borrowers-table"
							hx-include="[name='min_score'], [name='max_score'], [name='decision'], [name='search']"
						/>
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
							Max Score
						</label>
						<input 
							type="number" 
							id="max_score" 
							name="max_score"
							min="0" 
							max="150"
							class="block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm"
							hx-get="/htmx/borrowers-table"
							hx-trigger="input changed delay:500ms"
							hx-target="#borrowers-table"
							hx-include="[name='min_score'], [name='max_score'], [name='decision'], [name='search']"
						/>
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
							Decision
						</label>
						<select 
							id="decision" 
							name="decision"
							class="block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm"
							hx-get="/htmx/borrowers-table"
							hx-trigger="change"
							hx-target="#borrowers-table"
							hx-include="[name='min_score'], [name='max_score'], [name='decision'], [name='search']"
						>
							<option value="">All Decisions</option>
							<option value="ACCEPT">Accept</option>
							<option value="REVIEW">Review</option>
							<option value="REJECT">Reject</option>
						</select>
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
							Search
						</label>
						<input 
							type="text" 
							id="search" 
							name="search"
							placeholder="Name or email..."
							class="block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm"
							hx-get="/htmx/borrowers-table"
							hx-trigger="input changed delay:500ms"
							hx-target="#borrowers-table"
							hx-include="[name='min_score'], [name='max_score'], [name='decision'], [name='search']"
						/>
					</div>
				</div>
			</div>
		</div>

		<!-- Borrowers Table -->
		<div id="borrowers-table">
			@BorrowersTable(data.Borrowers)
		</div>
	</div>
}

templ BorrowersTable(borrowers []*models.Borrower) {
	<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
		<div class="px-4 py-5 sm:p-6">
			if len(borrowers) == 0 {
				<div class="text-center py-12">
					<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
					</svg>
					<h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-white">No borrowers found</h3>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
						Upload a CSV file to get started.
					</p>
					<div class="mt-6">
						<a href="/upload" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
							</svg>
							Upload Data
						</a>
					</div>
				</div>
			} else {
				<div class="overflow-x-auto">
					<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
						<thead class="bg-gray-50 dark:bg-gray-700">
							<tr>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
									Borrower
								</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
									Details
								</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
									Financial
								</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
									Risk Score
								</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
									Decision
								</th>
							</tr>
						</thead>
						<tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
							for _, borrower := range borrowers {
								<tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
									<td class="px-6 py-4 whitespace-nowrap">
										<div class="flex items-center">
											<div class="flex-shrink-0 h-10 w-10">
												<div class="h-10 w-10 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
													<span class="text-sm font-medium text-gray-700 dark:text-gray-200">
														{ string(borrower.FullName[0]) }
													</span>
												</div>
											</div>
											<div class="ml-4">
												<div class="text-sm font-medium text-gray-900 dark:text-white">
													{ borrower.FullName }
												</div>
												<div class="text-sm text-gray-500 dark:text-gray-400">
													{ borrower.Email }
												</div>
											</div>
										</div>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">
										<div class="space-y-1">
											<div>Age: { fmt.Sprintf("%d", borrower.Age) }</div>
											<div>Status: { borrower.EmploymentStatus }</div>
											<div>Dependents: { fmt.Sprintf("%d", borrower.Dependents) }</div>
										</div>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">
										<div class="space-y-1">
											<div>Income: ${ fmt.Sprintf("%.0f", borrower.MonthlyIncome) }</div>
											<div>Loans: ${ fmt.Sprintf("%.0f", borrower.ExistingLoans) }</div>
											<div>Savings: ${ fmt.Sprintf("%.0f", borrower.SavingsBalance) }</div>
										</div>
									</td>
									<td class="px-6 py-4 whitespace-nowrap">
										<div class="flex flex-col space-y-1">
											<div class="flex items-center">
												<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", scoreClass(borrower.RiskScore) }>
													{ fmt.Sprintf("%d", borrower.RiskScore) }
												</span>
											</div>
											<div class="text-xs text-gray-500 dark:text-gray-400 max-w-xs truncate" title={ borrower.ScoreExplanation }>
												{ borrower.ScoreExplanation }
											</div>
										</div>
									</td>
									<td class="px-6 py-4 whitespace-nowrap">
										<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", decisionClass(borrower.Decision) }>
											{ borrower.Decision }
										</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}

func scoreClass(score int) string {
	switch {
	case score >= 80:
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	case score >= 60:
		return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200"
	default:
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	}
}

func decisionClass(decision string) string {
	switch decision {
	case "ACCEPT":
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	case "REVIEW":
		return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200"
	case "REJECT":
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	default:
		return "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
	}
} 